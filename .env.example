# 실제 AI(Claude)를 쓰려면 이 파일 이름을 .env 로 바꾸고 키를 넣으세요.
# 키가 없으면 AI 기능은 규칙 기반 예시로 작동해요.
ANTHROPIC_API_KEY=
# 사용할 모델 (비워 두면 claude-haiku-5-5)
CLAUDE_MODEL=claude-haiku-5-5

# 인스타그램 바로 올리기 (Meta 개발자 앱에서 만든 'IG'로 시작하는 토큰)
INSTAGRAM_TOKEN=
# 공개 사이트에서 아무나 우리 계정에 올리지 못하게 막는 숫자 (팀만 알기)
INSTAGRAM_PUBLISH_PIN=
# 사진을 Meta가 가져갈 공개 주소 (Render는 자동이라 비워 둬도 됨)
PUBLIC_BASE_URL=
