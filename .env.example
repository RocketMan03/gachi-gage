# 사용할 LLM: auto | gemini | groq | mock
#  auto  = GEMINI_API_KEY가 있으면 gemini, 없고 GROQ_API_KEY가 있으면 groq, 둘 다 없으면 mock(데모 모드)
LLM_PROVIDER=auto

# Google Gemini (무료 티어) - https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# AI 이미지 그리기/보정용 (무료 키에서는 막혀 있을 수 있음 - 그래도 자동 보정·홍보 카드는 무료로 동작)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Groq (무료 티어, 대안) - https://console.groq.com/keys 에서 발급
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# AI 호출이 실패하면 데모용 규칙 기반 결과로 대신 보여줄지 (시연 중 끊김 방지)
FALLBACK_TO_MOCK=true

PORT=3000

# ---------- 인스타그램 (배포 서버용, 선택) ----------
# 여기에 넣으면 '계정 연결' 화면 대신 이 값을 써요. Render에서는 Environment에 넣어 주세요.
# IG…(인스타 로그인) 또는 EAA…(페이스북 로그인) 토큰. 앱에서 게시물 삭제는 EAA 토큰 + instagram_manage_contents 권한일 때만 돼요.
INSTAGRAM_TOKEN=
# EAA 토큰인데 연결된 페이지에서 계정을 못 찾을 때만 (인스타 비즈니스 계정 ID)
INSTAGRAM_USER_ID=
# 공개 사이트에서 아무나 우리 계정에 올리거나 지우지 못하게, 게시·삭제할 때 묻는 숫자
INSTAGRAM_PUBLISH_PIN=
# 사진을 가져갈 공개 주소 (Render는 RENDER_EXTERNAL_URL을 자동으로 써서 비워 둬도 돼요)
PUBLIC_BASE_URL=

# ---------- 페이스북 페이지 (선택) ----------
# 그래프 API 탐색기에서 '페이지 토큰'으로 바꾼 토큰과 페이지 ID. 넣으면 계정 연결 화면 대신 이 값을 써요.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# ---------- 스레드 (선택) ----------
THREADS_TOKEN=
